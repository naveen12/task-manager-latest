<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/kairo_widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Kairo"
            android:textColor="#F8FAFC"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_next_alarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/kairo_widget_pill"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Alarm: Off"
            android:textColor="#F59E0B"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="0 tasks · 0 reminders today"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_next_task"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="All caught up today"
        android:textColor="#E2E8F0"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_quick_task"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginRight="5dp"
            android:background="@drawable/kairo_widget_pill_accent"
            android:text="+ Task"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:padding="0dp" />

        <Button
            android:id="@+id/btn_quick_reminder"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginRight="5dp"
            android:background="@drawable/kairo_widget_pill"
            android:text="+ Remind"
            android:textAllCaps="false"
            android:textColor="#34D399"
            android:textSize="11sp"
            android:textStyle="bold"
            android:padding="0dp" />

        <Button
            android:id="@+id/btn_quick_alarm"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginRight="5dp"
            android:background="@drawable/kairo_widget_pill"
            android:text="+ Alarm"
            android:textAllCaps="false"
            android:textColor="#F59E0B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:padding="0dp" />

        <Button
            android:id="@+id/btn_quick_note"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/kairo_widget_pill"
            android:text="+ Note"
            android:textAllCaps="false"
            android:textColor="#C0C1FF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:padding="0dp" />
    </LinearLayout>
</LinearLayout>
